# Copy to .env and adjust: cp .env.example .env
BASE_URL=http://localhost:8080
# Protects /api/*. Leave empty only for local experiments.
ADMIN_TOKEN=change-me
# Optional: Google Safe Browsing v4 API key (https://developers.google.com/safe-browsing)
SAFE_BROWSING_API_KEY=
# How often each target is re-checked, and after how many failures it counts as broken
HEALTH_INTERVAL=15m
HEALTH_FAIL_THRESHOLD=3
# Set true if running behind a reverse proxy / CDN that sets X-Forwarded-For
TRUST_PROXY=false
CREATE_RATE_LIMIT=30
CACHE_TTL=10m
